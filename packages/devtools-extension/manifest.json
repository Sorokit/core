{
  "manifest_version": 3,
  "name": "sorokit-core DevTools",
  "version": "0.1.0",
  "description": "Inspect sorokit-core SDK operations (wallet, account, transaction, Soroban) in real time from your browser's DevTools.",
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "devtools_page": "devtools.html",
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content-script.js"],
      "run_at": "document_start",
      "world": "ISOLATED"
    }
  ],
  "permissions": [],
  "host_permissions": []
}
